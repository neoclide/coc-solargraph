#!/usr/bin/env node
'use strict'

const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')

const args = process.argv.slice(2)
const logFile = process.env.COC_SOLARGRAPH_TEST_LOG || path.join(os.tmpdir(), `coc-solargraph-test-${process.ppid}.jsonl`)

function record(type, data = {}) {
  fs.appendFileSync(logFile, JSON.stringify({ type, pid: process.pid, argv: args, cwd: process.cwd(), ...data }) + '\n')
}

if (args[0] === 'config') {
  record('command')
  process.exit(0)
}

if (args[0] !== 'stdio') {
  record('unsupported')
  process.exit(1)
}

record('start')

let buffer = Buffer.alloc(0)
process.stdin.on('data', chunk => {
  buffer = Buffer.concat([buffer, chunk])
  while (true) {
    const headerEnd = buffer.indexOf('\r\n\r\n')
    if (headerEnd === -1) return
    const header = buffer.subarray(0, headerEnd).toString('ascii')
    const match = /Content-Length: (\d+)/i.exec(header)
    if (!match) process.exit(2)
    const length = Number(match[1])
    const bodyStart = headerEnd + 4
    if (buffer.length < bodyStart + length) return
    const body = buffer.subarray(bodyStart, bodyStart + length).toString('utf8')
    buffer = buffer.subarray(bodyStart + length)
    handle(JSON.parse(body))
  }
})

function send(message) {
  const body = JSON.stringify(message)
  process.stdout.write(`Content-Length: ${Buffer.byteLength(body)}\r\n\r\n${body}`)
}

function respond(message, result) {
  send({ jsonrpc: '2.0', id: message.id, result })
}

function handle(message) {
  record(message.id == null ? 'notification' : 'request', { method: message.method, params: message.params })
  switch (message.method) {
    case 'initialize':
      respond(message, {
        capabilities: {
          textDocumentSync: 1,
          completionProvider: { resolveProvider: false }
        }
      })
      break
    case 'shutdown':
      respond(message, null)
      break
    case 'exit':
      process.exit(0)
      break
    case '$/solargraph/documentGems':
      respond(message, { status: 'ok' })
      break
    case '$/solargraph/search':
      respond(message, { content: `<h1>Search ${message.params.query}</h1>` })
      break
    case '$/solargraph/environment':
      respond(message, { content: '<h1>Solargraph Test Environment</h1>' })
      break
    default:
      if (message.id != null) respond(message, null)
      break
  }
}

process.on('SIGTERM', () => process.exit(0))
