#!/usr/bin/env node
'use strict'

const childProcess = require('node:child_process')
const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')

const args = process.argv.slice(2)
const logFile = path.join(os.tmpdir(), `coc-solargraph-test-${process.ppid}.jsonl`)
fs.appendFileSync(logFile, JSON.stringify({ type: 'bundler', pid: process.pid, argv: args, cwd: process.cwd() }) + '\n')

if (args[0] !== 'exec' || args[1] !== 'solargraph') process.exit(1)

const child = childProcess.spawn(path.join(__dirname, 'solargraph'), args.slice(2), {
  env: { ...process.env, COC_SOLARGRAPH_TEST_LOG: logFile },
  stdio: 'inherit'
})

child.on('exit', (code, signal) => {
  if (signal) process.kill(process.pid, signal)
  else process.exit(code == null ? 1 : code)
})

process.on('SIGTERM', () => child.kill())
